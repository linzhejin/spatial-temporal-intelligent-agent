# ===== 漫步珞珈 (WHU-Walker) 环境变量 =====

# LLM 配置 (DEC-006: DeepSeek V4-Flash)
DEEPSEEK_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 高德 JS API Key (前端地图底图, DEC-007)
# 去 https://console.amap.com/dev/ 申请 "JS API 2.0" 类型
AMAP_KEY=your-amap-key-here
AMAP_SECURITY_CODE=your-amap-security-code-here

# 高德 Web 服务类型 Key（与前端 JS Key 分开）；仅请求期查询入口，不写入开放主库。
AMAP_WEB_KEY=your-amap-web-key-here
AMAP_POI_LOOKUP_ENABLED=true

# 地图默认中心点 (武大核心区)
MAP_CENTER_LAT=30.5365
MAP_CENTER_LNG=114.3630
MAP_ZOOM=16

# Flask 配置
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=replace-with-a-random-secret
ROAD_CONDITION_ADMIN_PASSWORD=
ROAD_CONDITION_ADMIN_TOKEN=
# Production deploy.sh migrates existing events to this persistent runtime file.
ROAD_CONDITIONS_FILE=

# Agent 会话、任务和运行事件的持久化（PostgreSQL）
# 未配置时 /api/conversations 返回 503，不会伪装成已持久化。
DATABASE_URL=postgresql://whu_walker:replace-me@127.0.0.1:5432/whu_walker

# Durable Agent workers (run with `python -m jobs.worker`)
AGENT_WORKER_CONCURRENCY=3

# 独立的机载影像分析进程：`python -m vision.worker`
# 权重需预先放在服务器本地；用户上传不会触发模型下载。
VISION_UPLOAD_DIR=data/vision/uploads
VISION_MAX_VIDEO_BYTES=1073741824
VISION_CHUNK_BYTES=8388608
VISION_MODEL_PATH=
VISION_MODEL_ID=visdrone-rtdetrv4-s
VISION_MODEL_REVISION=820fca3d962243f7d611dd35cf2a64d267635499
VISION_CONFIDENCE_THRESHOLD=0.369
VISION_TRACKING_MIN_CONFIDENCE=0.1
# auto uses the process CPU allowance, capped at 4; set 1 for the small Tencent worker.
VISION_CPU_THREADS=auto
# ROI tile batches default to serial; increase only after benchmarking the target worker.
VISION_TILE_BATCH_SIZE=1
VISION_ACCIDENT_ENABLED=false
VISION_ACCIDENT_MODEL_PATH=
VISION_ACCIDENT_REVISION=unverified
VISION_ACCIDENT_THRESHOLD=0.85
# Candidate scheduling only; final accident candidates still use the model threshold above.
VISION_ACCIDENT_DENSE_TRIGGER_THRESHOLD=0.5
VISION_ACCIDENT_DENSE_WINDOW_SECONDS=2.0
VISION_FLOOD_ENABLED=false
VISION_FLOOD_MODEL_PATH=
VISION_FLOOD_REVISION=unverified
VISION_FLOOD_MIN_AREA_RATIO=0.08
# Keep unset until a model-specific threshold is calibrated on held-out data.
VISION_VISIBLE_WATER_CLASS_PROBABILITY_THRESHOLD=
VISION_MAX_MEDIA_BYTES=25165824
VISION_MAX_FRAME_PIXELS=12500000
VISION_SAMPLE_FPS=5
VISION_SEGMENT_FRAMES=180
VISION_MAX_ANALYSIS_SECONDS=3600
VISION_MAX_EVENT_AGE_SECONDS=900

# CORS (生产环境配置，用逗号分隔多个 Origin)
# CORS_ORIGINS=https://your-app.onrender.com

# 武大校园路网边界框 (用于 OSM 路网下载)
WHU_BBOX_NORTH=30.5480
WHU_BBOX_SOUTH=30.5280
WHU_BBOX_EAST=114.3750
WHU_BBOX_WEST=114.3500
